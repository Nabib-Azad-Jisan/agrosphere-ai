# Copy to .env in the monorepo root. Keep local demo bound to loopback.
DATA_SOURCE_MODE=simulation
LOCAL_DEMO=true
# Generate a random 32+ character value before using Docker or protected mode.
ADMIN_TOKEN=
POSTGRES_USER=agrosphere
POSTGRES_PASSWORD=
POSTGRES_DB=agrosphere
# SQLite is convenient for native development; Docker overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./agrosphere.db
API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STALE_MINUTES=60
WEATHER_CACHE_MINUTES=30
WEATHER_MAX_AGE_MINUTES=180
WEATHER_TIMEOUT=10
INGESTION_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=1048576
